# Modo de datos de KOVO.
# demo: datos ficticios locales (por defecto y siempre seguro para desarrollo visual).
# supabase: backend DEV; la carga legacy permanece bloqueada hasta terminar el importador.
VITE_DATA_MODE=demo

# Proyecto Supabase de DESARROLLO. Copia este archivo a .env.local (ignorado por Git) y pon ahí
# la URL y la publishable key de tu proyecto DEV.
# - Nunca uses aquí el proyecto de producción.
# - Nunca introduzcas service_role ni claves secretas en variables VITE_* (llegan al navegador).
# El valor de ejemplo no existe a propósito: si se copia sin cambiar, no conecta con nada.
VITE_SUPABASE_URL=https://TU-PROYECTO-DEV.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
